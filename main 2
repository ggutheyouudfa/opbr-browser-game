<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Grand Sea: 3D Haki Arena</title>
<script src="https://cloudflare.com"></script>
<style>
:root{--ink:#071425;--panel:#101f36;--gold:#f4c44e;--blue:#38bdf8;--red:#ef5a67;--green:#4ade80;--purple:#a855f7}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;color:#f7fbff;background:radial-gradient(circle at 10% 10%,#14325a 0,#09182c 40%,#07111f 100%);font-family:Inter,Segoe UI,system-ui,sans-serif;min-height:100vh}
button,select,input{font:inherit}
.shell{max-width:1280px;margin:auto;padding:22px 20px 40px}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px}
.brand{font-weight:900;font-size:24px;letter-spacing:.5px}.brand span{color:var(--gold)}
.wallet{display:flex;gap:10px}
.chip{background:#ffffff10;border:1px solid #ffffff17;border-radius:999px;padding:8px 14px;font-size:13px}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px}
.filters{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.filters input,.filters select{padding:10px 14px;border-radius:10px;border:1px solid #ffffff25;background:#0b192e;color:#fff}
.filters input{flex:1;min-width:180px}
.fighters{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:12px;max-height:70vh;overflow-y:auto;padding-right:6px}
.fighters::-webkit-scrollbar{width:6px}
.fighters::-webkit-scrollbar-thumb{background:#ffffff30;border-radius:6px}
.card{position:relative;border:1px solid #ffffff15;border-radius:12px;overflow:hidden;background:linear-gradient(145deg,#172a48,#0d1b31);cursor:pointer;transition:.15s}
.card:hover{transform:translateY(-2px);border-color:#ffffff45}
.card.captain{border:2px solid var(--gold);box-shadow:0 0 18px #f4c44e40}
.card.ally{border:2px solid var(--blue);box-shadow:0 0 18px #38bdf840}
.art{height:145px;position:relative;overflow:hidden;background:#081426}
.art img{width:100%;height:100%;object-fit:cover;display:block}
.badge{position:absolute;top:8px;right:8px;font-size:10px;font-weight:900;padding:3px 7px;border-radius:6px;background:#000c;color:#fff;letter-spacing:.4px}
.captain .badge{background:var(--gold);color:#111}
.ally .badge{background:var(--blue);color:#071425}
.el-tag{position:absolute;top:8px;left:8px;font-size:10px;font-weight:800;padding:3px 7px;border-radius:6px;background:#000a}
.info{padding:10px}
.info h3{margin:0 0 4px;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.info small{color:#9cb0c8;font-size:11px;font-weight:700}
.side{background:#101e34;border:1px solid #ffffff15;border-radius:14px;padding:20px;height:max-content;position:sticky;top:20px}
.side h2{margin:0 0 12px;font-size:18px}
.side label{display:block;font-size:11px;color:#9cb0c8;margin:14px 0 6px;font-weight:800;text-transform:uppercase}
.side select{width:100%;padding:11px;border-radius:8px;border:1px solid #ffffff25;background:#081426;color:#fff}
.slots{display:flex;flex-direction:column;gap:8px}
.slot{background:#081426;border:1px dashed #ffffff25;border-radius:8px;padding:10px;font-size:13px;display:flex;justify-content:space-between;align-items:center}
.slot.filled{border-style:solid;border-color:#ffffff35}
.battle-btn{width:100%;border:0;border-radius:9px;padding:14px;background:var(--gold);color:#172033;font-weight:900;cursor:pointer;margin-top:18px;font-size:15px}
.battle-btn:disabled{background:#3b4a60;color:#7d8aa0;cursor:not-allowed}

/* 3D ARENA OVERLAY */
.arena{position:fixed;inset:0;z-index:50;background:#050b14;display:none;touch-action:none}
.arena.open{display:block}
#canvas3d{width:100%;height:100%;display:block}
.hud{position:absolute;inset:0;pointer-events:none;padding:16px;display:flex;flex-direction:column;justify-content:space-between}
.hud-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}
.hud-card{background:#0b192ee0;backdrop-filter:blur(6px);border:1px solid #ffffff25;border-radius:12px;padding:10px 14px;min-width:210px}
.bar-label{display:flex;justify-content:space-between;font-size:11px;color:#9cb0c8;margin-top:6px;font-weight:700}
.hp-track{height:9px;background:#0009;border-radius:5px;overflow:hidden;margin-top:3px}
.hp-fill{height:100%;background:var(--green);transition:width .15s}
.haki-fill{height:100%;background:linear-gradient(90deg,#9333ea,#ef4444);transition:width .1s}
.score-box{text-align:center;background:#0b192ee0;border:1px solid var(--gold);border-radius:14px;padding:8px 18px;pointer-events:auto}
.flags-row{display:flex;gap:6px;justify-content:center;margin:5px 0}
.flag-dot{width:18px;height:18px;border-radius:50%;background:#475569;border:2px solid #fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:900}
.flag-dot.blue{background:var(--blue);color:#000}
.flag-dot.red{background:var(--red);color:#fff}
.exit-btn{background:var(--red);color:#fff;border:0;border-radius:6px;padding:5px 12px;font-size:12px;font-weight:800;cursor:pointer;margin-top:4px}
.combat-banner{position:absolute;top:110px;left:50%;transform:translateX(-50%);background:#090d16dd;border:1px solid var(--gold);color:var(--gold);padding:6px 18px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.6px;opacity:0;transition:opacity .2s}
.combat-banner.show{opacity:1}
.hud-bottom{display:flex;justify-content:space-between;align-items:flex-end}
.dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px);gap:4px;pointer-events:auto}
.dpad button{background:#101f36cc;border:1px solid #ffffff30;border-radius:10px;color:#fff;font-weight:900;font-size:12px;cursor:pointer}
.dpad button:active{background:var(--gold);color:#000}
.controls-tip{background:#0b192ee0;border:1px solid #ffffff20;padding:8px 14px;border-radius:10px;font-size:11px;color:#cbd5e1;line-height:1.6;text-align:center}
.controls-tip kbd{background:#ffffff25;padding:2px 5px;border-radius:4px;color:#fff}
.skills{display:flex;gap:8px;pointer-events:auto}
.skill-btn{width:80px;height:74px;border-radius:12px;border:2px solid var(--gold);background:#101f36e6;color:#fff;font-weight:900;font-size:11px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.skill-btn.haki-btn{border-color:#c084fc;background:linear-gradient(145deg,#3b0764,#1e1b4b)}
.skill-btn:disabled{opacity:.4;border-color:#64748b;cursor:not-allowed}
.end-modal{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#07111ff5;border:2px solid var(--gold);padding:28px 40px;border-radius:16px;text-align:center;display:none;pointer-events:auto;width:min(90%,420px)}
.end-modal h1{margin:0 0 8px;color:var(--gold);font-size:30px}
@media(max-width:850px){.layout{grid-template-columns:1fr}.side{position:static}.controls-tip{display:none}}
</style>
</head>
<body>

<div class="shell">
  <header class="topbar">
    <div class="brand">GRAND SEA <span>3D HAKI ARENA</span></div>
    <div class="wallet">
      <div class="chip">All Fighters: <b style="color:var(--green)">16 / 16 UNLOCKED</b></div>
      <div class="chip">Bounty Coins: <b id="coins">50,000</b></div>
    </div>
  </header>

  <main class="layout">
    <section>
      <div class="filters">
        <input id="searchBox" placeholder="Search unlocked character...">
        <select id="classFilter">
          <option value="ALL">All Classes</option>
          <option value="Attacker">Attacker</option>
          <option value="Runner">Runner</option>
          <option value="Defender">Defender</option>
        </select>
        <select id="elFilter">
          <option value="ALL">All Elements</option>
          <option value="Crimson">Crimson</option>
          <option value="Azure">Azure</option>
          <option value="Emerald">Emerald</option>
          <option value="Solar">Solar</option>
          <option value="Shadow">Shadow</option>
        </select>
      </div>
      <div id="rosterGrid" class="fighters"></div>
    </section>

    <aside class="side">
      <h2>3D Match Setup</h2>
      <label>1. Choose 3D Arena Map</label>
      <select id="arenaSelect"></select>

      <label>2. Pick Captain (You) + 2 AI Allies</label>
      <div class="slots" id="teamSlots"></div>

      <button id="startBtn" class="battle-btn">ENTER 3D HAKI ARENA</button>
    </aside>
  </main>
</div>

<!-- 3D ARENA -->
<div id="arena" class="arena">
  <div id="canvas3d"></div>
  <div class="hud">
    <div class="hud-top">
      <div class="hud-card">
        <div style="font-weight:900;color:var(--blue)" id="hudCapName">Captain</div>
        <div class="bar-label"><span>HEALTH</span><span id="hudCapHpText">100/100</span></div>
        <div class="hp-track"><div id="hudCapHpBar" class="hp-fill"></div></div>
        <div class="bar-label"><span style="color:#c084fc" id="hudHakiType">HAKI</span><span id="hudHakiText">100%</span></div>
        <div class="hp-track"><div id="hudHakiBar" class="haki-fill"></div></div>
      </div>

      <div class="score-box">
        <div style="font-size:10px;color:#9cb0c8;text-transform:uppercase" id="hudMapTitle">ARENA</div>
        <div style="font-size:18px;font-weight:900"><span style="color:var(--blue)" id="blueFlags">0</span> - <span style="color:var(--red)" id="redFlags">0</span></div>
        <div class="flags-row" id="flagDots"></div>
        <div style="font-size:12px;color:var(--gold);font-weight:800" id="timerText">Time: 90s</div>
        <button class="exit-btn" id="exitBtn">Exit Match</button>
      </div>

      <div class="hud-card" style="text-align:right">
        <div style="font-weight:900;color:var(--red)">Rival Fleet (3D AI)</div>
        <div style="font-size:12px;color:#9cb0c8">Attacks Clash Mid-Air!</div>
