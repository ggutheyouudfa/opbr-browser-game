using UnityEngine;
using UnityEngine.UI;

public class RosterUIGenerator : MonoBehaviour
{
    public GameObject portraitButtonPrefab; // UI Button with an Image component
    public Transform gridContainer;
    public bool isSelectingAllies = false;

    void Start()
    {
        PopulateRoster();
    }

    void PopulateRoster()
    {
        var roster = MatchSetupManager.Instance.allUnlockedFighters;

        for (int i = 0; i < roster.Count; i++)
        {
            int index = i; // Capture index for button click listener
            GameObject btnObj = Instantiate(portraitButtonPrefab, gridContainer);
            
            // Set the character's picture
            btnObj.GetComponent<Image>().sprite = roster[i].portrait;

            // Assign click behavior
            btnObj.GetComponent<Button>().onClick.AddListener(() => OnPortraitClicked(index));
        }
    }

    void OnPortraitClicked(int index)
    {
        if (isSelectingAllies)
            MatchSetupManager.Instance.AddAlly(index);
        else
            MatchSetupManager.Instance.SelectPlayer(index);
    }
}
